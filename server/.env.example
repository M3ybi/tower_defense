DATABASE_URL="postgresql://user:password@host/db"
JWT_SECRET="change_me_to_long_random"
COOKIE_NAME="td_session"
COOKIE_SECURE="true"           # "false" for local dev
CORS_ORIGIN="http://127.0.0.1:8080"
NODE_ENV="production"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-api-domain/auth/google/callback"

AMAZON_CLIENT_ID="your-amazon-client-id"
AMAZON_CLIENT_SECRET="your-amazon-client-secret"
AMAZON_REDIRECT_URI="https://your-api-domain/auth/amazon/callback"
